# ========================================
# Database (Supabase Postgres)
# ========================================
# 從 Supabase Dashboard → Project Settings → Database → Connection string 拿：
#
# 1) DATABASE_URL  使用 "Connection pooling"（Transaction mode）— port 6543
#    這條給 Next.js runtime 用（每個 server function 共用 PgBouncer 池）
# 2) DIRECT_URL    使用 "Connection string"（Session mode）— port 5432
#    這條給 prisma migrate / prisma db push 用（PgBouncer 不支援 prepared statements）
#
# 兩條都要設定！記得把 [YOUR-PASSWORD] 換成實際的 DB 密碼。

# connection_limit=5 + pool_timeout：Dashboard 等多查詢頁面需要；純 seed 仍用 DIRECT_URL
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ========================================
# Auth
# ========================================
# Production 請務必改！產生方式：openssl rand -base64 32
AUTH_SECRET="please-change-me-to-a-long-random-string-32-chars-min"

# Session 有效時間（小時），預設 7 天（HQ 與 POS 共用時長設定；cookie 名稱分離）
SESSION_HOURS=168

# 換罐「忘帶罐／保留下次領」天數（產品設定值，勿硬編碼在業務邏輯）
WAITING_FOR_JAR_RESERVATION_DAYS=14

# 建立店家 POS 帳號（scripts/create-merchant-user.ts）時於執行環境注入，勿寫進 repo：
# MERCHANT_ID=MER-0001 USERNAME=store01 PASSWORD=******** npm run merchant:create-user


# Vercel Cron 驗證（/api/cron/expire-coupons 每日過期優惠券）
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ========================================
# LINE Messaging API（換罐序號 / 綁定會員）
# ========================================
# LINE Developers → Messaging API Channel
# Webhook URL: https://你的網域/api/line/webhook
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# LINE Login 頻道 Channel ID（非 Messaging API Bot），LIFF ID Token 驗證用
LINE_CHANNEL_ID="2009953429"
# LIFF App ID（LINE Login 頻道 → LIFF 列表）
LINE_LIFF_ID_REGISTER="2009953429-1mrFjT2V"
LINE_LIFF_ID_PROFILE="2009953429-xnxlaC87"
LINE_LIFF_ID_REWARDS="2009953429-8UJ2ZY5L"

# 野放中外連（選填；不設則用程式預設）
# LINE_BRAND_WEBSITE_URL="https://furmosa.pet"
# LINE_BRAND_INSTAGRAM_URL="https://www.instagram.com/furmosa_tw/"
# LINE_BRAND_THREADS_URL="https://www.threads.net/@furmosa_tw"
# LINE_BRAND_FACEBOOK_URL="https://www.facebook.com/furmosa.tw"
# LINE_BRAND_NEWS_URL="https://furmosa.pet"

# 會員站核銷頁網域（後台「店家核銷連結」顯示用）
NEXT_PUBLIC_MEMBER_SITE_URL="https://member.furmosa.pet"

# ========================================
# Web Push（主畫面 App 新訂單通知）
# ========================================
# 產生：npx web-push generate-vapid-keys
# Vercel 環境變數也需設定這三項
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@furmosa.com"
