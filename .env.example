# ========================================
# Database (Supabase Postgres)
# ========================================
# 從 Supabase Dashboard → Project Settings → Database → Connection string 拿：
#
# 1) DATABASE_URL  使用 "Connection pooling"（Transaction mode）— port 6543
#    這條給 Next.js runtime 用（每個 server function 共用 PgBouncer 池）
# 2) DIRECT_URL    使用 "Connection string"（Session mode）— port 5432
#    這條給 prisma migrate / prisma db push 用（PgBouncer 不支援 prepared statements）
#
# 兩條都要設定！記得把 [YOUR-PASSWORD] 換成實際的 DB 密碼。

# connection_limit=5 + pool_timeout：Dashboard 等多查詢頁面需要；純 seed 仍用 DIRECT_URL
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ========================================
# Auth
# ========================================
# Production / Vercel Preview 必填（未設定會直接拒絕 JWT）。產生：openssl rand -base64 32
AUTH_SECRET="please-change-me-to-a-long-random-string-32-chars-min"

# Session 有效時間（小時），預設 7 天（HQ 與 POS 共用時長設定；cookie 名稱分離）
SESSION_HOURS=168

# 店家身分確認寫入（正式小範圍）。預設關閉。
# 未另填 WRITERS 時，只允許總部 HQ：admin / finance / ops / wh @furmosa.com
# PARTNER_STORE_IDENTITY_WRITES=enabled
# PARTNER_STORE_IDENTITY_WRITERS=
# 限量套用已鎖定五組時必須同時設定；未設定時五家真店仍拒寫。
# PARTNER_STORE_IDENTITY_TARGET=approved-five

# 換罐「忘帶罐／保留下次領」天數（產品設定值，勿硬編碼在業務邏輯）
WAITING_FOR_JAR_RESERVATION_DAYS=14

# 建立店家 POS 帳號（scripts/create-merchant-user.ts）時於執行環境注入，勿寫進 repo：
# MERCHANT_ID=MER-0001 USERNAME=store01 PASSWORD=******** npm run merchant:create-user

# Preview 自動建 HQ／POS demo（scripts/ensure-demo-admin.ts）
# - Vercel Preview／Production：自動綁真實「妞妞」店 → POS 帳號 niuniu
# - Preview 另建 MER-DEMO + admin（沙盒，勿對帳）
# ENABLE_DEMO_ADMIN=1  # 強制跑完整 demo
# ENSURE_NIUNIU_POS=0  # 關閉妞妞 POS 自動綁定


# Vercel Cron 驗證（/api/cron/*）
# Preview／Production 必填；未設或 Bearer 不符 → 401
# 本機 development 未設時可放行（方便手動打 cron）
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ========================================
# LINE Messaging API（換罐序號 / 綁定會員）
# ========================================
# LINE Developers → Messaging API Channel
# Webhook URL: https://你的網域/api/line/webhook
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# LINE Login 頻道 Channel ID（非 Messaging API Bot），LIFF ID Token 驗證用
LINE_CHANNEL_ID="2009953429"
# LIFF App ID（LINE Login 頻道 → LIFF 列表）
LINE_LIFF_ID_REGISTER="2009953429-1mrFjT2V"
LINE_LIFF_ID_PROFILE="2009953429-xnxlaC87"
LINE_LIFF_ID_REWARDS="2009953429-8UJ2ZY5L"
# 換罐付款 LIFF（Endpoint: https://你的網域/liff/refill）
LINE_LIFF_ID_REFILL=""

# ========================================
# 綠界 ECPay（換罐／補差額收款；webhook 為付款真相）
# ========================================
# Stage: https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# Prod:  https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_PAYMENT_URL="https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5"
# 未設時預設 {NEXT_PUBLIC_APP_URL}/api/payments/ecpay/return
# ECPAY_RETURN_URL=""
# Server callback（綠界 OrderResultURL）
# ECPAY_ORDER_RESULT_URL=""
# Webhook 正式路徑：https://你的網域/api/payments/ecpay/callback

# 雞霸開箱 60 元物流處理費轉帳（只放 Vercel Production；程式只讀 env）
# 範例為 placeholder，不要填真實帳號。正式值只設在 Vercel Production。
JIBA_TRANSFER_BANK_NAME="EXAMPLE_BANK"
JIBA_TRANSFER_BANK_CODE="000"
JIBA_TRANSFER_ACCOUNT="000000000000"

# Flex 卡片插畫用的公開網域（建議設正式網址）
NEXT_PUBLIC_APP_URL="https://furmosa-db.vercel.app"

# 野放中外連（選填；不設則用程式預設）
# LINE_BRAND_WEBSITE_URL="https://furmosa.pet"
# LINE_BRAND_INSTAGRAM_URL="https://www.instagram.com/furmosa_tw/"
# LINE_BRAND_THREADS_URL="https://www.threads.net/@furmosa_tw"
# LINE_BRAND_FACEBOOK_URL="https://www.facebook.com/furmosa.tw"
# LINE_BRAND_NEWS_URL="https://furmosa.pet"

# 青蛙誰在怕獨立專案網址（選填；設了之後「嗷嗚計劃」會附進入按鈕）
# LINE_FROG_PROJECT_URL="https://..."

# 店家核銷固定走同一部署的 /pos/login，不再使用外部會員站或 Preview 網址。

# ========================================
# Web Push（主畫面 App 新訂單通知）
# ========================================
# 產生：npx web-push generate-vapid-keys
# Vercel 環境變數也需設定這三項
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@furmosa.com"

# ========================================
# Shopify（訂單建立即匯入；付款後更新同一筆訂單）
# ========================================
# Shopify Admin → Settings → Notifications → Webhooks
# Topic: Order creation；URL: https://你的網域/api/shopify/webhooks/orders-create
# Topic: Order payment；URL: https://你的網域/api/shopify/webhooks/orders-paid
# Topic: Order update；URL: https://你的網域/api/shopify/webhooks/orders-updated
# 此值必須只放在 Vercel 環境變數，不可提交真實 secret。
SHOPIFY_WEBHOOK_SECRET=""
# 必填：限制只接受這間商店，例如 your-store.myshopify.com；未設定回 503。
SHOPIFY_SHOP_DOMAIN=""
# 手動補同步：僅伺服器可讀；需要既有 REST-capable custom app 的 read_orders 權限。
# 不可使用 NEXT_PUBLIC_；不要把真實 token 放進版控。
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# 僅在確認 DB 與 Shopify 都為隔離測試來源後啟用；Vercel production 一律拒絕。
SHOPIFY_RECONCILE_TEST_MODE="false"
