  orders    Order[]

  @@index([customerId])
  @@index([status])
  @@index([nextShipmentDate])
}

// æ¯æ¬¡é å®š / å·²å‡ºçš„è¨‚é–±å‡ºè²¨
model SubscriptionShipment {
