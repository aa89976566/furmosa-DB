// Furmosa HQ - Prisma schema
// Production: Supabase Postgres
//   - DATABASE_URL  → pgbouncer 6543（runtime 共用連線池）
//   - DIRECT_URL    → 5432（prisma migrate / introspect 專用）
// 金額目前仍用 Float（先求快速上線），日後可全面改 Decimal(12,2)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// Enums (SQLite 用 String + 應用層約束)
// 對應的合法值參考 lib/labels.ts。
// =====================================================

// =====================================================
// Users (system operators)
// =====================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("staff") // admin / staff / finance / warehouse
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks       Task[]                 @relation("AssignedTasks")
  pointsLedgerCreated MemberPointsLedger[]   @relation("PointsLedgerCreatedBy")
  pushSubscriptions   UserPushSubscription[]
  restockApprovals    RestockRequest[]       @relation("RestockApprovedBy")
}

model UserPushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_push_subscriptions")
}

// =====================================================
// Master Data
// =====================================================

model Vendor {
  id           String   @id @default(cuid())
  vendorId     String   @unique // VEND-0001
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  paymentTerms String?
  notes        String?
  status       String   @default("active") // active / inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
}

// 客戶（人）= 主檔。會員身份、訂閱身份都掛在 Customer 上。
model Customer {
  id         String  @id @default(cuid())
  customerId String  @unique // furmosa-0001
  name       String
  type       String  @default("individual") // individual / business
  phone      String?
  email      String?
  address    String?

  // 預設運輸偏好（新增訂單時自動帶入）
  preferredShippingMethod String? // home / convenience
  preferredCvsBrand       String? // 711 / familymart / hilife
  preferredCvsStoreId     String?
  preferredCvsStoreName   String?

  // 聯繫 / 社群
  lineUserId  String?
  lineDisplay String? // LINE 顯示名稱
  socialIg    String?
  socialFb    String?

  // 個資
  birthday DateTime?
  gender   String? // female / male / other / unknown

  // 毛孩（與主檔會員一對一；選填，見 lib/customers/pet-fields.ts）
  petSpecies       String?   @map("pet_species") // dog / cat / rabbit / … / other
  petSpeciesOther  String?   @map("pet_species_other")
  petName          String?   @map("pet_name")
  petBreed         String?   @map("pet_breed")
  petAgeYears      Int?      @map("pet_age_years")
  petBirthday      DateTime? @map("pet_birthday")

  // 換罐計畫開戶店家（LINE 開戶時選填，永久綁定）
  signupStore String? @map("signup_store")
  storeId     String? @map("store_id")
  storeName   String? @map("store_name")

  appointments Appointment[]
  refillOrders RefillOrder[]

  // 訂閱會員 flag（為了好查；真正資料看 subscriptions 關聯）
  hasActiveSubscription Boolean @default(false)

  // 標籤
  tags String @default("[]") // JSON-encoded string array

  // 銷售統計
  totalSpent  Float     @default(0)
  lastOrderAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders              Order[]
  subscriptions       Subscription[]
  shipments           Shipment[]
  services            CustomerService[]
  jarCodesRedeemed    JarCode[]              @relation("JarCodesRedeemed")
  pointsLedger        MemberPointsLedger[]
  rewardRedemptions   RewardRedemption[]
  marketingCosts      MarketingCostRecord[]
  groomingCoupons     GroomingCoupon[]

  @@index([hasActiveSubscription])
  @@index([lastOrderAt])
  @@index([name])
  @@index([phone])
  @@index([lineUserId])
}

// LINE 官方帳號多步驟對話（加入會員等）暫存
model LineChatSession {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  flow       String
  step       String
  payload    String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 記錄每個 LINE 用戶最後一次收到主選單的時間，用來在 24 小時內避免重複洗版選單
model LineMenuState {
  lineUserId            String    @id
  lastMenuSentAt        DateTime  @default(now())
  lastRegisterPromptAt  DateTime?
  lastJarPromptAt       DateTime?
  lastUnknownReplyAt    DateTime?
  triggerReplyAt        Json?
  updatedAt             DateTime  @updatedAt
}

// =====================================================
// 換罐會員（Jar Exchange）— 服務類型可疊加
// =====================================================

/// 會員服務類型：personal | subscription | jar_exchange（同一客戶可多筆）
model CustomerService {
  id            String    @id @default(cuid())
  customerId    String    @map("customer_id")
  serviceType   String    @map("service_type")
  serviceStatus String    @default("active") @map("service_status") // active | paused | closed
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceType])
  @@index([serviceType, serviceStatus])
  @@map("customer_services")
}

/// 瓶底 8 碼序號。
/// status 雙軌：
/// - unused → used：既有 LINE 兑碼入點（保留，不可破壞）
/// - unused → issued → returned：換罐交付生命週期（NT$99 資格看 issued）
/// - expired：作廢
model JarCode {
  id                   String    @id @default(cuid())
  code                 String    @unique
  batchNo              String?   @map("batch_no")
  productSku           String?   @map("product_sku")
  pointValue           Int       @default(1) @map("point_value")
  /// unused | issued | returned | used | expired
  status               String    @default("unused")
  redeemedByCustomerId String?   @map("redeemed_by_customer_id")
  redeemedAt           DateTime? @map("redeemed_at")
  issuedAt             DateTime? @map("issued_at")
  returnedAt           DateTime? @map("returned_at")
  issuedMerchantId     String?   @map("issued_merchant_id")
  returnedMerchantId   String?   @map("returned_merchant_id")
  /// 進行中／已占用此舊罐的換罐訂單
  lockedByRefillOrderId String?  @map("locked_by_refill_order_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  redeemedByCustomer Customer?    @relation("JarCodesRedeemed", fields: [redeemedByCustomerId], references: [id], onDelete: SetNull)
  issuedMerchant     Merchant?    @relation("JarCodesIssuedAt", fields: [issuedMerchantId], references: [id], onDelete: SetNull)
  returnedMerchant   Merchant?    @relation("JarCodesReturnedAt", fields: [returnedMerchantId], references: [id], onDelete: SetNull)
  lockedByRefillOrder RefillOrder? @relation("JarCodeLockedByRefill", fields: [lockedByRefillOrderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([batchNo])
  @@index([redeemedByCustomerId])
  @@index([lockedByRefillOrderId])
  @@map("jar_codes")
}

model MemberPointsLedger {
  id              String   @id @default(cuid())
  customerId      String   @map("customer_id")
  /// jar_code_redeem | manual_adjustment | reward_redemption | grooming_coupon_redemption | campaign_bonus | refill_completed
  sourceType      String   @map("source_type")
  sourceRefId     String?  @map("source_ref_id")
  pointsChange    Int      @map("points_change")
  balanceAfter    Int      @map("balance_after")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PointsLedgerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([sourceType])
  @@index([sourceType, sourceRefId])
  @@map("member_points_ledger")
}

// =====================================================
// 換罐訂單／綠界付款（Stage 5 LIFF refill）
// =====================================================

/// 換罐／首罐訂單（綁定預約店家；美容費不在此收取）
model RefillOrder {
  id                     String    @id @default(cuid())
  customerId             String    @map("customer_id")
  appointmentId          String    @map("appointment_id")
  merchantId             String    @map("merchant_id")
  petName                String?   @map("pet_name")
  productId              String?   @map("product_id")
  /// first | exchange
  orderType              String    @map("order_type")
  baseAmount             Int       @map("base_amount")
  extraAmount            Int       @default(0) @map("extra_amount")
  totalAmount            Int       @map("total_amount")
  /// draft | payment_pending | paid_waiting_return | old_container_verified | completed | payment_failed | cancelled | expired | awaiting_extra_payment
  status                 String
  /// exchange | first（補差額後改 first，可不驗舊罐）
  deliveryMode           String    @default("exchange") @map("delivery_mode")
  oldContainerSerial     String?   @map("old_container_serial")
  newContainerSerial     String?   @map("new_container_serial")
  missingContainerNote   String?   @map("missing_container_note")
  paidAt                 DateTime? @map("paid_at")
  oldContainerReturnedAt DateTime? @map("old_container_returned_at")
  completedAt            DateTime? @map("completed_at")
  /// 加點完成時間；與 ledger sourceRefId 雙重冪等
  pointsAwardedAt        DateTime? @map("points_awarded_at")
  idempotencyKey         String?   @unique @map("idempotency_key")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointment Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  payments    PaymentOrder[]
  auditLogs   RefillAuditLog[]
  lockedJarCodes JarCode[]   @relation("JarCodeLockedByRefill")

  @@index([customerId, status])
  @@index([merchantId, status])
  @@index([appointmentId])
  @@index([status, createdAt])
  @@map("refill_orders")
}

model PaymentOrder {
  id              String    @id @default(cuid())
  refillOrderId   String    @map("refill_order_id")
  /// refill | extra_topup
  purpose         String
  provider        String    @default("ecpay")
  merchantTradeNo String    @unique @map("merchant_trade_no")
  amount          Int
  /// pending | paid | failed
  status          String    @default("pending")
  providerTradeNo String?   @map("provider_trade_no")
  paidAt          DateTime? @map("paid_at")
  callbackPayload Json?     @map("callback_payload")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refillOrder RefillOrder      @relation(fields: [refillOrderId], references: [id], onDelete: Cascade)
  auditLogs   RefillAuditLog[]

  @@index([refillOrderId, purpose])
  @@index([status])
  @@map("payment_orders")
}

model RefillAuditLog {
  id             String   @id @default(cuid())
  refillOrderId  String?  @map("refill_order_id")
  paymentOrderId String?  @map("payment_order_id")
  action         String
  /// customer | merchant | system | ecpay
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  merchantId     String?  @map("merchant_id")
  serial         String?
  success        Boolean  @default(true)
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  refillOrder  RefillOrder?  @relation(fields: [refillOrderId], references: [id], onDelete: SetNull)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([refillOrderId, createdAt])
  @@index([paymentOrderId])
  @@index([action, createdAt])
  @@map("refill_audit_logs")
}

model RewardCatalog {
  id                  String    @id @default(cuid())
  rewardCode          String    @unique @map("reward_code")
  rewardName          String    @map("reward_name")
  rewardType          String    @default("grooming_coupon") @map("reward_type")
  pointsRequired      Int       @map("points_required")
  couponFaceValue     Float     @map("coupon_face_value")
  internalCost        Float     @map("internal_cost")
  partnerMerchantId   String?   @map("partner_merchant_id")
  activeStatus        String    @default("active") @map("active_status") // active | inactive
  startAt             DateTime? @map("start_at")
  endAt               DateTime? @map("end_at")
  description         String?
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  partnerMerchant Merchant?          @relation("RewardPartnerMerchant", fields: [partnerMerchantId], references: [id], onDelete: SetNull)
  redemptions     RewardRedemption[]

  @@index([activeStatus])
  @@map("reward_catalog")
}

model RewardRedemption {
  id                  String    @id @default(cuid())
  redemptionCode      String    @unique @map("redemption_code")
  customerId          String    @map("customer_id")
  rewardId            String    @map("reward_id")
  pointsSpent         Int       @map("points_spent")
  couponCode          String?   @map("coupon_code")
  couponStatus        String    @default("issued") @map("coupon_status") // issued | used | cancelled
  issuedAt            DateTime  @default(now()) @map("issued_at")
  usedAt              DateTime? @map("used_at")
  partnerMerchantId   String?   @map("partner_merchant_id")
  costBookedStatus    String    @default("booked") @map("cost_booked_status") // pending | booked | void
  note                String?
  createdAt           DateTime  @default(now()) @map("created_at")

  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward          RewardCatalog        @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  partnerMerchant Merchant?            @relation("RedemptionPartnerMerchant", fields: [partnerMerchantId], references: [id], onDelete: SetNull)
  marketingCost   MarketingCostRecord?

  @@index([customerId])
  @@index([couponStatus])
  @@map("reward_redemptions")
}

/// 換罐／會員獎勵行銷成本（非商品銷售收入）
model MarketingCostRecord {
  id            String   @id @default(cuid())
  costCode      String   @unique @map("cost_code")
  redemptionId  String?  @unique @map("redemption_id")
  customerId    String?  @map("customer_id")
  amount        Float
  costCategory  String   @map("cost_category") // jar_return_program | member_loyalty | marketing
  paymentStatus String   @default("accrued") @map("payment_status") // accrued | paid | void
  bookedAt      DateTime @default(now()) @map("booked_at")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  redemption RewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([bookedAt])
  @@index([costCategory])
  @@map("marketing_cost_records")
}

/// 合作美容院（LINE 開戶 / 優惠券核銷專屬連結）
model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  secretToken String   @map("secret_token")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  refillStocks MerchantRefillStock[]

  @@map("stores")
}

/// 美容院折價券（10 點兌換 250 元，30 天有效，限綁定店家核銷）
model GroomingCoupon {
  id             String    @id @default(cuid())
  customerId     String    @map("user_id")
  couponCode     String    @unique @map("coupon_code")
  storeId        String    @map("store_id")
  storeName      String    @map("store_name")
  type           String    @default("grooming_250")
  discountAmount Float     @default(250) @map("discount_amount")
  pointsUsed     Int       @map("points_used")
  status         String    @default("available") // available | redeemed | expired
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  redeemedAt     DateTime? @map("redeemed_at")
  redeemedStore  String?   @map("redeemed_store")
  redeemedBy     String?   @map("redeemed_by")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([storeId, status])
  @@index([status, expiresAt])
  @@map("coupons")
}

model Merchant {
  id             String   @id @default(cuid())
  merchantId     String   @unique // MER-0001
  name           String
  type           String   @default("consignment") // 主要類型（複選時取第一項）
  types          String[] @default(["consignment"]) // consignment / pop_up / flagship / partner / jar_exchange
  industry       String? // beauty / restaurant / cafe / hypermarket
  contactName    String?
  phone          String?
  email          String?
  address        String? // 黑貓／宅配收件地址
  city           String?
  // 進貨預設運輸（建立出貨單時自動帶入）
  preferredCarrier String? // 7-11 / 黑貓 / 送貨
  pickupStoreName  String? // 7-11 取件門市名稱
  commissionRate Float    @default(0.30) // fallback；個別商品仍以 MerchantProductRule 為準
  notes          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders                 Order[]
  settlements            Settlement[]
  productRules           MerchantProductRule[]
  partnerRewards         RewardCatalog[]      @relation("RewardPartnerMerchant")
  partnerRedemptions     RewardRedemption[]   @relation("RedemptionPartnerMerchant")
  stocks       MerchantStock[]
  stockTxns    MerchantStockTxn[]
  shipments    Shipment[]
  users        MerchantUser[]
  settings     MerchantSettings?
  restockRequests RestockRequest[]
  appointments Appointment[]
  refillOrders RefillOrder[]
  jarCodesIssued   JarCode[] @relation("JarCodesIssuedAt")
  jarCodesReturned JarCode[] @relation("JarCodesReturnedAt")
}

/// 店家營運設定（勿把 feature flags 繼續塞進 Merchant）
model MerchantSettings {
  id                      String   @id @default(cuid())
  merchantId              String   @unique @map("merchant_id")
  waitingForJarDays       Int      @default(14) @map("waiting_for_jar_days")
  appointmentEnabled      Boolean  @default(false) @map("appointment_enabled")
  lineNotificationEnabled Boolean  @default(true) @map("line_notification_enabled")
  allowAutoApproveRestock Boolean  @default(false) @map("allow_auto_approve_restock")
  /// 共用班表：每天開始（HH:mm，店家本地語意；存字串）
  bookingOpenTime         String   @default("09:00") @map("booking_open_time")
  bookingCloseTime        String   @default("18:00") @map("booking_close_time")
  /// 每格分鐘數
  bookingSlotMinutes      Int      @default(60) @map("booking_slot_minutes")
  /// 顧客端每格可視為「滿」的預約數（requested+confirmed+reschedule_proposed）
  bookingCapacityPerSlot  Int      @default(1) @map("booking_capacity_per_slot")
  /// 可預約星期：0=日 … 6=六，逗號分隔
  bookingWeekdays         String   @default("1,2,3,4,5,6") @map("booking_weekdays")
  /// 店家接收「有新預約」的 LINE User ID（U 開頭）；空則不推播店家
  bookingNotifyLineUserId String?  @map("booking_notify_line_user_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_settings")
}

/// Booking MVP：顧客預約店（Merchant），不是預約某位美容師
model Appointment {
  id                 String    @id @default(cuid())
  merchantId         String    @map("merchant_id")
  customerId         String    @map("customer_id")
  serviceProductId   String?   @map("service_product_id")
  serviceName        String    @map("service_name")
  petName            String?   @map("pet_name")
  startsAt           DateTime  @map("starts_at")
  endsAt             DateTime  @map("ends_at")
  /// requested | confirmed | reschedule_proposed | cancelled
  status             String    @default("requested")
  customerNote       String?   @map("customer_note")
  merchantNote       String?   @map("merchant_note")
  proposedStartsAt   DateTime? @map("proposed_starts_at")
  proposedEndsAt     DateTime? @map("proposed_ends_at")
  /// customer | merchant | hq
  createdBy          String    @map("created_by")
  /// 店家／HQ 手動寫入已滿時段時為 true（顧客端永不因此看到該格）
  isOverbooked       Boolean   @default(false) @map("is_overbooked")
  confirmedAt        DateTime? @map("confirmed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  /// LINE 通知冪等：已處理（成功或略過無收件人）後寫入，避免 cron／重試重送
  lineNotifyReceivedAt    DateTime? @map("line_notify_received_at")
  lineNotifyMerchantNewAt DateTime? @map("line_notify_merchant_new_at")
  lineNotifyConfirmedAt   DateTime? @map("line_notify_confirmed_at")
  lineReminder1dAt        DateTime? @map("line_reminder_1d_at")
  lineReminder2hAt        DateTime? @map("line_reminder_2h_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceProduct Product? @relation(fields: [serviceProductId], references: [id], onDelete: SetNull)
  refillOrders RefillOrder[]

  @@index([merchantId, startsAt])
  @@index([merchantId, status])
  @@index([customerId, createdAt])
  @@index([status, startsAt])
  @@map("appointments")
}

/// 店家 POS 登入帳號（一 Merchant 可多筆；Phase 1 營運上先維持一店一 active）
model MerchantUser {
  id           String    @id @default(cuid())
  merchantId   String    @map("merchant_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  restockRequests RestockRequest[]

  @@index([merchantId])
  @@map("merchant_users")
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique // WH-MAIN
  name      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
}

model Product {
  id           String   @id @default(cuid())
  productId    String   @unique // PROD-0001
  sku          String   @unique
  sourceSku    String? // 使用者單價表的 SKU（DK-01 / FD-04 / PF-02 ...）
  name         String
  category     String   @default("other") // staple_food / treats / health / freeze_dried / toys / accessories / other
  /// 平台商品類型（非零食子類）：STANDARD / JAR_EXCHANGE / SERVICE / VOUCHER / DONATION
  productCategory String @default("STANDARD") @map("product_category")
  style        String? // 款式（凍肉 / 蔬果 ...）
  description  String?
  imageUrl     String?
  unit         String   @default("件") // 克 / 隻 / 片 / 包...
  price        Float // 基礎售價（最小重量級距，方便舊 UI 顯示）
  cost         Float    @default(0) // 進貨成本（每包/隻/片）
  reorderPoint Int      @default(10)
  status       String   @default("active") // active / inactive / draft
  vendorId     String?
  notes        String? // 備註（單價表手寫欄位）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor                Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  priceTiers            ProductPriceTier[]
  orderItems            OrderItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  merchantRules         MerchantProductRule[]
  merchantStocks        MerchantStock[]
  merchantStockTxns     MerchantStockTxn[]
  shipmentItems         ShipmentItem[]
  restockRequestItems   RestockRequestItem[]
  appointments          Appointment[]
  refillOrders          RefillOrder[]

  @@index([productCategory])
  @@index([status])
  @@index([name])
}

// 同一個產品可能依重量分多種售價（30g / 50g / 100g / 150g），
// 或以「隻 / 片」為單位賣（unitQty>1 例如 5隻=325）。
model ProductPriceTier {
  id          String  @id @default(cuid())
  productId   String
  weightGrams Int? // 30 / 50 / 100 / 150；以隻/片計時可為 null
  unit        String // 克 / 隻 / 片
  unitQty     Int     @default(1) // 內含幾份（5隻一袋之類）
  price       Float
  cost        Float? // 此規格成本（選填）
  notes       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, weightGrams, unit, unitQty])
  @@index([productId])
}

// 寄賣商品 × 店家 的售價與抽成規則
model MerchantProductRule {
  id              String   @id @default(cuid())
  merchantId      String
  productId       String
  suggestedPrice  Float // 建議售價（給消費者的價格）
  commissionMode  String   @default("amount") // amount / percent
  commissionValue Float // 若 amount：每件抽多少錢；若 percent：抽幾 %
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, productId])
  @@index([productId])
  @@index([merchantId])
}

// =====================================================
// Shipment（出貨／物流）— 統一 B2B（寄賣進貨）和 B2C（客戶/訂閱）
// 流程：pending → packed → shipped → delivered（或 cancelled）
// 只有 delivered 才會真正 +到店家庫存 / 標 fulfillment_done
// =====================================================
model Shipment {
  id             String @id @default(cuid())
  shipmentNumber String @unique // SHP-202605-0001
  type           String // merchant_restock / customer_order / subscription
  status         String @default("pending") // pending / packed / shipped / delivered / cancelled

  // 來源／關聯（依 type 不同填一個）
  merchantId             String? // for merchant_restock
  customerId             String? // for customer_order
  orderId                String? // for customer_order
  subscriptionShipmentId String? @unique // for subscription（一對一）

  // 收件 / 物流
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?
  carrier          String? // 黑貓 / 7-11 / 順豐 / 自送 / ...
  trackingNumber   String?

  // 時間軸
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant             Merchant?             @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscriptionShipment SubscriptionShipment? @relation(fields: [subscriptionShipmentId], references: [id], onDelete: SetNull)
  items                ShipmentItem[]
  restockRequest       RestockRequest?

  @@index([status])
  @@index([type])
  @@index([merchantId])
  @@index([customerId])
  @@index([orderId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

/// POS 一鍵叫貨申請（核准後轉既有 merchant_restock Shipment）
model RestockRequest {
  id                        String    @id @default(cuid())
  merchantId                String    @map("merchant_id")
  requestedByMerchantUserId String    @map("requested_by_merchant_user_id")
  /// SELF_SELECT | AUTO_REPLENISH
  requestType               String    @map("request_type")
  /// draft | submitted | under_review | approved | rejected | converted_to_shipment | cancelled
  status                    String    @default("submitted")
  merchantNote              String?   @map("merchant_note")
  hqNote                    String?   @map("hq_note")
  expectedArrivalDate       DateTime? @map("expected_arrival_date")
  /// 核准當下品項快照（UI 顯示用；Shipment 仍為履約真相）
  approvedSnapshot          Json?     @map("approved_snapshot")
  approvedByUserId          String?   @map("approved_by_user_id")
  approvedAt                DateTime? @map("approved_at")
  rejectedAt                DateTime? @map("rejected_at")
  shipmentId                String?   @unique @map("shipment_id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  requestedBy MerchantUser @relation(fields: [requestedByMerchantUserId], references: [id], onDelete: Restrict)
  approvedBy  User?        @relation("RestockApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  shipment    Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items       RestockRequestItem[]

  @@index([merchantId, status])
  @@index([status, createdAt])
  @@map("restock_requests")
}

model RestockRequestItem {
  id                String   @id @default(cuid())
  restockRequestId  String   @map("restock_request_id")
  productId         String   @map("product_id")
  requestedQuantity Int?     @map("requested_quantity")
  approvedQuantity  Int?     @map("approved_quantity")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  restockRequest RestockRequest @relation(fields: [restockRequestId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([restockRequestId])
  @@index([productId])
  @@map("restock_request_items")
}

model ShipmentItem {
  id          String  @id @default(cuid())
  shipmentId  String
  productId   String
  productName String
  sku         String
  quantity    Int
  weightGrams Int? // 每件重量（g）— 同商品可有不同 g 數
  unit        String? // 片 / 包 / 支 / 件...
  notes       String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([productId])
}

// 寄賣店目前持有的庫存（每家店 × 商品 × 規格一筆；tierId 空字串為舊版合計）
model MerchantStock {
  id            String    @id @default(cuid())
  merchantId    String
  productId     String
  tierId        String    @default("")
  quantity      Int       @default(0)
  lastRestockAt DateTime?
  lastSaleAt    DateTime?
  lastCountAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, productId, tierId])
  @@index([merchantId])
  @@index([productId])
}

// 寄賣動作流水帳：進貨 / 銷售 / 盤點 / 退回
model MerchantStockTxn {
  id               String   @id @default(cuid())
  txnNumber        String   @unique // MTXN-202605-0001
  merchantId       String
  productId        String
  type             String // restock / sale / adjust / return
  quantity         Int // 進貨正、銷售/退回負；adjust 為 「異動量」（balanceAfter - 之前）
  balanceAfter     Int // 異動後該店該商品庫存
  unitPrice        Float? // 銷售時的售價
  commissionAmount Float? // 銷售時店家抽成總額
  companyRevenue   Float? // 銷售時公司實收總額
  orderId          String? // 對應的訂單
  settlementId     String? // 已被某筆結算 lock；結算時填入，避免重複結清
  note             String?
  createdAt        DateTime @default(now())

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([settlementId])
  @@index([type, createdAt])
  @@index([merchantId, type, createdAt])
}

// =====================================================
// Inventory
// =====================================================

model InventoryBalance {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  txnNumber   String   @unique // INV-202605-001
  type        String // purchase_in / sales_out / transfer / adjustment / stocktake / return_in / return_out
  productId   String
  warehouseId String
  quantity    Int
  unitCost    Float?
  reference   String?
  batchCode   String?
  serialCode  String?
  note        String?
  createdAt   DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// =====================================================
// Order Hub
// =====================================================

model Order {
  id                String    @id @default(cuid())
  orderNumber       String    @unique // ORD-202605-001
  source            String // website / line / consignment / subscription / manual
  status            String    @default("draft") // draft / confirmed / packed / shipped / delivered / completed / cancelled
  paymentStatus     String    @default("unpaid") // unpaid / partial / paid / cod / refunded
  shippingFeeType   String    @default("unpaid") // free 包郵 / prepaid 已付費 / unpaid 不包郵 / cod 運費貨到付款
  fulfillmentStatus String    @default("pending") // pending / packed / shipped / delivered / returned
  customerId        String?
  merchantId        String?
  subscriptionId    String? // 若為訂閱衍生的訂單
  subtotal          Float
  discount          Float     @default(0)
  shippingFee           Float @default(0) // 買家於此單支付的運費（不包郵／貨到付時為標準運費）
  companyShippingCost   Float @default(0) // 公司負擔的運費成本（包郵時為 711/黑貓 標準運費）
  giftCost              Float @default(0) // 贈品進貨成本合計（不計入買家應付）
  total                 Float
  shippingMethod    String    @default("home") // home / convenience / delivery
  shippingAddress   String? // 宅配：家用地址；超商：可填門市地址
  cvsBrand          String? // 711 / familymart / hilife（僅 shippingMethod=convenience 時使用）
  cvsStoreId        String? // 門市店號
  cvsStoreName      String? // 門市名稱
  note              String?
  orderedAt         DateTime  @default(now())
  shippedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  merchant          Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  merchantStockTxns MerchantStockTxn[]
  shipments         Shipment[]

  @@index([source])
  @@index([status])
  @@index([orderedAt])
  @@index([subscriptionId])
  @@index([customerId])
  @@index([merchantId])
  @@index([status, orderedAt])
  @@index([source, orderedAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  subtotal    Float
  isGift      Boolean @default(false) // 贈品：買家單價為 0，仍計入公司成本
  unitCost    Float? // 贈品／成本紀錄：單件進貨成本
  weightGrams Int? // 每件重量（g）
  unit        String? // 片 / 包 / 支 / 件...

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// =====================================================
// Settlement
// =====================================================

model Settlement {
  id               String    @id @default(cuid())
  settlementId     String    @unique // SET-202605-001
  merchantId       String
  periodStart      DateTime
  periodEnd        DateTime
  grossSales       Float // 店家收的現金（依銷售流水加總）
  commissionRate   Float // 此期實際抽成率（commissionAmount / grossSales）
  commissionAmount Float // 店家應得分潤
  rewardPayout     Float     @default(0) // 換罐補貼（公司付給店家）
  shippingFee      Float     @default(0) // 運費（公司補給店家／或店家代墊）
  merchantOwesUs   Float     @default(0) // 店家應返公司金額 = grossSales - commissionAmount - rewardPayout - shippingFee
  payable          Float // 兼容舊欄位：等於 commissionAmount + rewardPayout + shippingFee（公司應付店家）
  status           String    @default("draft") // draft / reviewing / approved / paid
  paidAt           DateTime?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  txns     MerchantStockTxn[]

  @@index([merchantId])
  @@index([status])
}

// =====================================================
// Subscription (訂閱制)
// =====================================================

// 方案定義（小食組 / 標準組 / 豪華組）
model SubscriptionPlan {
  id                String   @id @default(cuid())
  planCode          String   @unique // PLAN-LIGHT / PLAN-STANDARD / PLAN-DELUXE
  name              String // 小食組
  tagline           String? // 輕鬆入門 / 嚐鮮首選
  monthlyPrice      Float // 399
  halfYearPrice     Float? // 2100
  halfYearSavings   Float? // 294
  shipmentsPerMonth Int      @default(1) // 1 / 2
  shipDays          String   @default("[15]") // JSON: [15] 或 [1, 15]
  contents          String   @default("[]") // JSON: [{name, weight, note}]
  bonusItems        String? // JSON: [{name, interval}]
  recommendedFor    String? // 5kg 以下小型犬 / ...
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

// 客戶的訂閱合約
model Subscription {
  id               String    @id @default(cuid())
  subscriptionNo   String    @unique // SUB-202605-001
  customerId       String
  planId           String
  status           String    @default("active") // active / paused / cancelled / expired
  billingCycle     String    @default("monthly") // monthly / halfyear
  startDate        DateTime
  endDate          DateTime? // 半年方案會有結束日
  nextShipmentDate DateTime?
  recipientName    String
  recipientPhone   String
  shippingAddress  String
  notes            String?
  // 此訂閱專屬的盒內內容（JSON），未設定則沿用方案 plan.contents / plan.bonusItems
  customContents   String? // JSON: [{name, weight, note}]
  customBonus      String? // JSON: [{name}]
  paymentType      String    @default("monthly") // full / monthly / other
  paymentNote      String? // 選「其他」時可填说明
  pausedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer  Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  shipments SubscriptionShipment[]
  orders    Order[]

  @@index([customerId])
  @@index([status])
  @@index([nextShipmentDate])
}

// 每次預定 / 已出的訂閱出貨
model SubscriptionShipment {
  id             String    @id @default(cuid())
  shipmentNo     String    @unique // SHIP-202605-001
  subscriptionId String
  scheduledDate  DateTime
  status         String    @default("pending") // pending / packed / shipped / delivered / skipped
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  trackingNo     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shipment     Shipment? // 對應到統一的 Shipment 紀錄（後建）

  @@index([subscriptionId])
  @@index([scheduledDate])
  @@index([status])
}

// =====================================================
// Task Ops
// =====================================================

model Task {
  id          String    @id @default(cuid())
  taskId      String    @unique // TASK-0001
  title       String
  description String?
  type        String    @default("general") // inventory_issue / settlement_followup / customer_service / vendor_followup / marketing / shipment / general
  status      String    @default("todo") // todo / in_progress / done / blocked
  priority    String    @default("medium") // low / medium / high / urgent
  dueDate     DateTime?
  assigneeId  String?
  reference   String? // 可放 SHIP-xxx / ORD-xxx 等
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  assignee User? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([dueDate])
}

// =====================================================
// Dashboard KPI 預聚合（cron／讀頁共用）
// =====================================================

model DashboardKpiSnapshot {
  id         String   @id @default("default")
  payload    Json
  computedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([computedAt])
}

// =====================================================
// UGC 活動（雞霸兩片開箱等）— LINE 對話為介面，DB 為真相
// =====================================================

model Campaign {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  status           String    @default("active") // draft / active / paused / ended
  coverImageUrl    String?   @map("cover_image_url")
  productName      String    @default("雞霸") @map("product_name")
  productQuantity  Int       @default(2) @map("product_quantity")
  productUnitPrice Float     @default(0) @map("product_unit_price")
  shippingFee      Float     @default(60) @map("shipping_fee")
  licenseVersion   String    @default("ugc-v1") @map("license_version")
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  applications CampaignApplication[]

  @@map("campaigns")
}

model CampaignApplication {
  id                    String    @id @default(cuid())
  campaignId            String    @map("campaign_id")
  customerId            String?   @map("customer_id")
  lineUserId            String    @map("line_user_id")
  lineDisplayName       String?   @map("line_display_name")
  linePictureUrl        String?   @map("line_picture_url")
  lineProfileSyncedAt   DateTime? @map("line_profile_synced_at")
  orderId               String?   @unique @map("order_id")
  instagramHandle       String?   @map("instagram_handle")
  petName               String?   @map("pet_name")
  recipientName         String?   @map("recipient_name")
  recipientPhone        String?   @map("recipient_phone")
  storeId               String?   @map("store_id")
  storeName             String?   @map("store_name")
  storeAddress          String?   @map("store_address")
  status                String    @default("COLLECTING_INFO")
  // COLLECTING_INFO / PENDING_REVIEW / APPROVED / AWAITING_SHIPPING_PAYMENT /
  // READY_TO_SHIP / REJECTED / CANCELLED_BY_USER / CANCELLED
  shippingQueueStatus   String    @default("NOT_READY") @map("shipping_queue_status")
  // NOT_READY / QUEUED
  licenseAccepted       Boolean   @default(false) @map("license_accepted")
  licenseVersion        String?   @map("license_version")
  licenseAcceptedAt     DateTime? @map("license_accepted_at")
  licenseSourceMsgId    String?   @map("license_source_message_id")
  reviewedBy            String?   @map("reviewed_by")
  reviewedAt            DateTime? @map("reviewed_at")
  reviewNote            String?   @map("review_note")
  returnFields          String?   @map("return_fields") // JSON string array
  paymentToken          String?   @unique @map("payment_token")
  paymentStatus         String    @default("unpaid") @map("payment_status")
  // unpaid / paid / failed
  paidAt                DateTime? @map("paid_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  campaign            Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversationSession ConversationSession?
  reviews             OrderReview[]
  auditLogs           StatusAuditLog[]

  @@index([campaignId, status])
  @@index([lineUserId, status])
  @@index([orderId])
  @@map("campaign_applications")
}

model ConversationSession {
  id                    String    @id @default(cuid())
  lineUserId            String    @map("line_user_id")
  campaignApplicationId String    @unique @map("campaign_application_id")
  currentState          String    @map("current_state")
  collectedDataJson     String    @default("{}") @map("collected_data_json")
  operatorTakeover      Boolean   @default(false) @map("operator_takeover")
  startedAt             DateTime  @default(now()) @map("started_at")
  completedAt           DateTime? @map("completed_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  application CampaignApplication   @relation(fields: [campaignApplicationId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]

  @@index([lineUserId, currentState])
  @@map("conversation_sessions")
}

model ConversationMessage {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  lineMessageId String?  @map("line_message_id")
  senderType    String   @map("sender_type") // customer / bot / system / supervisor
  messageType   String   @default("text") @map("message_type")
  contentJson   String   @map("content_json")
  sentAt        DateTime @default(now()) @map("sent_at")

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sentAt])
  @@map("conversation_messages")
}

model OrderReview {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  orderId       String?  @map("order_id")
  reviewerId    String?  @map("reviewer_id")
  reviewerName  String?  @map("reviewer_name")
  decision      String // APPROVED / RETURNED / REJECTED
  reasonCode    String?  @map("reason_code")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  application CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("order_reviews")
}

model StatusAuditLog {
  id             String   @id @default(cuid())
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  actorType      String   @map("actor_type") // customer / bot / supervisor / system / payment
  actorId        String?  @map("actor_id")
  metadataJson   String?  @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")
  applicationId  String?  @map("application_id")

  application CampaignApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([applicationId])
  @@map("status_audit_logs")
}

// =====================================================
// 換罐計劃：口味主檔／合作店庫存（LINE 介紹與後台）
// =====================================================

/// 換罐口味（本期可選品項；UI 不寫死）
model RefillFlavour {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  weightGrams    Int       @map("weight_grams")
  imageUrl       String?   @map("image_url")
  isActive       Boolean   @default(true) @map("is_active")
  availableFrom  DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stocks    MerchantRefillStock[]
  stockTxns RefillStockTxn[]

  @@index([isActive, sortOrder])
  @@map("refill_flavours")
}

/// 合作店口味庫存（實際可選依店家當期庫存）
model MerchantRefillStock {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  flavourId       String   @map("flavour_id")
  quantity        Int      @default(0)
  isAvailable     Boolean  @default(true) @map("is_available")
  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  flavour RefillFlavour @relation(fields: [flavourId], references: [id], onDelete: Cascade)

  @@unique([storeId, flavourId])
  @@index([flavourId])
  @@index([storeId, isAvailable])
  @@map("merchant_refill_stocks")
}

/// 庫存異動紀錄
model RefillStockTxn {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  flavourId       String   @map("flavour_id")
  changeQty       Int      @map("change_qty")
  quantityAfter   Int      @map("quantity_after")
  reason          String // adjust | period_copy | out_of_stock | restock | seed
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  flavour RefillFlavour @relation(fields: [flavourId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([flavourId, createdAt])
  @@map("refill_stock_txns")
}

/// 換罐計劃全域設定（主視覺、價格重點）
model RefillPlanSettings {
  id                 String   @id @default("default")
  heroImageUrl       String?  @map("hero_image_url")
  firstJarPrice      Int      @default(129) @map("first_jar_price")
  exchangePrice      Int      @default(99) @map("exchange_price")
  pointsPerJar       Int      @default(1) @map("points_per_jar")
  pointsForDiscount  Int      @default(10) @map("points_for_discount")
  discountAmount     Int      @default(200) @map("discount_amount")
  flavourUpdateNote  String   @default("每兩週更新") @map("flavour_update_note")
  periodStartedAt    DateTime? @map("period_started_at")
  periodEndedAt      DateTime? @map("period_ended_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("refill_plan_settings")
}
