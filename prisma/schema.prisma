// =====================================================
// Inventory
// =====================================================

model InventoryBalance {
  unit          String? // null = legacy quantity, awaiting physical count
  lastCountedAt DateTime?
  countNote     String?
  id            String    @id @default(cuid())
  productId     String
  warehouseId   String
  quantity      Int       @default(0)
  updatedAt     DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
}

model InventoryTransaction {
  unit        String?
  eventKey    String?               @unique
  reversesId  String?               @unique
  reverses    InventoryTransaction? @relation("HqReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal    InventoryTransaction? @relation("HqReversal")
  id          String                @id @default(cuid())
  txnNumber   String                @unique // INV-202605-001
  type        String // purchase_in / sales_out / transfer / adjustment / stocktake / return_in / return_out
  productId   String
  warehouseId String
  quantity    Int
  unitCost    Float?
  reference   String?
  batchCode   String?
  serialCode  String?
  note        String?
  createdAt   DateTime              @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
