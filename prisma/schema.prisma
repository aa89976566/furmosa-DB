// æ–¹æ¡ˆå®šç¾©ï¼ˆå°é£Ÿçµ„ / æ¨™æº–çµ„ / è±ªè¯çµ„ï¼‰
model SubscriptionPlan {
  id                String   @id @default(cuid())
  planCode          String   @unique // PLAN-LIGHT / PLAN-STANDARD / PLAN-DELUXE
  name              String // å°é£Ÿçµ„
  tagline           String? // è¼•é¬†å…¥é–€ / åšé®®é¦–é¸
  monthlyPrice      Float // 399
