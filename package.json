{
  "name": "furmosa-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && WATCHPACK_POLLING=true next dev",
    "build": "prisma generate && (prisma migrate resolve --rolled-back 20260722110000_qimu_delivery_address || true) && (prisma migrate resolve --applied 20260722110000_qimu_delivery_address || true) && (prisma migrate deploy || echo 'migrate deploy skipped') && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:check": "prisma migrate deploy && node -e \"const {PrismaClient}=require('@prisma/client');const p=new PrismaClient();p.\\$queryRaw\\`SELECT 1\\`.then(()=>{console.log('資料庫連線成功');return p.\\$disconnect();}).catch(e=>{console.error('連線失敗:',e.message);process.exit(1);})\"",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:setup": "prisma migrate dev --name init && prisma db seed",
    "db:clear": "tsx prisma/clear.ts",
    "db:import": "tsx prisma/import.ts",
    "db:import-prices": "tsx prisma/import.ts --price-only",
    "db:reset": "prisma migrate reset --force",
    "test": "node --import tsx --test lib/jar-exchange/__tests__/*.test.ts lib/line/__tests__/*.test.ts lib/orders/__tests__/*.test.ts lib/merchant-auth/__tests__/*.test.ts lib/restock-request/__tests__/*.test.ts lib/booking/__tests__/*.test.ts lib/coupons/__tests__/*.test.ts lib/__tests__/*.test.ts lib/campaigns/jiba-two-piece/__tests__/*.test.ts",
    "merchant:create-user": "tsx scripts/create-merchant-user.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@line/liff": "^2.29.0",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.14.8",
    "@vercel/functions": "^2.2.13",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.451.0",
    "next": "^14.2.15",
    "next-themes": "^0.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
